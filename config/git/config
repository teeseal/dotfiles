[user]
	name = Alex Hincu
	email = alex@teeseal.dev
[core]
	editor = nvim
[init]
	defaultBranch = main
[fetch]
	prune = true
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[alias]
	bda = "!f() { local default_branch=$(git config init.defaultBranch || echo 'master'); git branch --no-color --merged $default_branch | grep -vE $default_branch | xargs -r git branch -d; }; f"
[include]
	path = config.local
